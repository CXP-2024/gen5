-// Template for implementing custom routing algorithm
-// using port directions. (Example adaptive)
+// Shortest-direction routing for the Ring (1D torus) topology of
+// configs/topologies/Ring.py.  Router i is connected to (i+1) % N over its
+// "East" port and to (i-1) % N over its "West" port, so a packet only ever
+// has two choices: keep going clockwise or counter-clockwise.  We pick
+// whichever direction covers fewer hops and break the tie (an exactly
+// diametrically opposite destination on an even-sized ring) deterministically
+// towards "East" so that all packets of a flow follow the same path.
+//
+// Routing is computed once per packet at the source-side hop and then simply
+// followed, so the direction chosen here never reverses mid-flight; the
+// asserts below check that invariant.
 int
 RoutingUnit::outportComputeCustom(RouteInfo route,
                                  int inport,
                                  PortDirection inport_dirn)
 {
-    panic("%s placeholder executed", __FUNCTION__);
+    int num_routers = m_router->get_net_ptr()->getNumRouters();
+    assert(num_routers > 2);
+
+    int my_id = m_router->get_id();
+    int dest_id = route.dest_router;
+
+    // already checked in outportCompute()
+    assert(my_id != dest_id);
+
+    // Hops needed if we keep travelling in each of the two directions.
+    int cw_hops = (dest_id - my_id + num_routers) % num_routers;
+    int ccw_hops = num_routers - cw_hops;
+
+    PortDirection outport_dirn = "Unknown";
+    if (cw_hops <= ccw_hops) {
+        // Clockwise: increasing router id, leave through "East".
+        assert(inport_dirn == "Local" || inport_dirn == "West");
+        outport_dirn = "East";
+    } else {
+        // Counter-clockwise: decreasing router id, leave through "West".
+        assert(inport_dirn == "Local" || inport_dirn == "East");
+        outport_dirn = "West";
+    }
+
+    return m_outports_dirn2idx[outport_dirn];
 }
 
 } // namespace garnet
